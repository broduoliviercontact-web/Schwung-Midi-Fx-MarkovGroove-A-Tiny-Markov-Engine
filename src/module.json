{
  "id": "markov_groove",
  "name": "MarkovGroove",
  "abbrev": "MG",
  "version": "0.1.0",
  "description": "Markov-chain melodic sequencer with swing groove, synced to Move transport.",
  "dsp": "dsp.so",
  "api_version": 1,

